    // ================= MEDIA PLAYER WINDOW =================
    media_player_window:
    (
        // ── Window ───────────────────────────────────────────────────────
        window_size:                  (340, 500),
        window_padding:               18,
        background_color:             HEX("1d2021"),
        background_border_color:      HEX("504945"),
        background_border_size:       1.0,
        background_border_radius:     (8.0, 8.0, 8.0, 8.0),

        // ── Layout ───────────────────────────────────────────────────────
        row_order:                    [Fill, Prev, PlayPause, Next, Fill],
        row_height:                   54,
        row_spacing:                  14,
        section_spacing:              18,

        // ── Metadata (title) ────────────────────────────────────────────
        metadata_text_size:           15,
        metadata_text_color:          HEX("ebdbb2"),
        metadata_max_chars:           80,
        metadata_button_style:
        (
            color:                  RGBA((0, 0, 0, 0)),
            hovered_color:          RGBA((0, 0, 0, 0)),
            pressed_color:          RGBA((0, 0, 0, 0)),
            text_color:             HEX("ebdbb2"),
            hovered_text_color:     HEX("ebdbb2"),
            pressed_text_color:     HEX("928374"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (0.0, 0.0, 0.0, 0.0),
            gradient_color:         None,
            hovered_gradient_color: None,
            pressed_gradient_color: None,
        ),
        metadata_button_height:       24,
        metadata_button_width:        0.0,

        // ── Transport button labels ─────────────────────────────────────
        prev_label:     "󰒮",
        play_label:     "▶",
        pause_label:    "󰏤",
        next_label:     "󰒭",
        vol_down_label: "󰝞",
        vol_up_label:   "󰝝",

        // ── Transport button styles ─────────────────────────────────────
        button_text_size:             16,
        button_width:                 40,
        button_height:                40,
        button_style:
        (
            color:                  RGBA((0, 0, 0, 0)),
            hovered_color:          HEX("504945"),
            pressed_color:          HEX("463f3b"),
            text_color:             HEX("ebdbb2"),
            hovered_text_color:     HEX("ebdbb2"),
            pressed_text_color:     HEX("928374"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (6.0, 6.0, 6.0, 6.0),
            gradient_color:         None,
            hovered_gradient_color: None,
            pressed_gradient_color: None,
        ),
        play_button_style:
        (
            color:                  HEX("fabd2f"),
            hovered_color:          HEX("ffc739"),
            pressed_color:          HEX("f0b325"),
            text_color:             HEX("1d2021"),
            hovered_text_color:     HEX("1d2021"),
            pressed_text_color:     HEX("1d2021"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (6.0, 6.0, 6.0, 6.0),
            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("fabd2f")), (1.0, HEX("ffd648"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("ffc537")), (1.0, HEX("ffde50"))]))),
            pressed_gradient_color: None,
        ),
        pause_button_style:
        (
            color:                  HEX("fabd2f"),
            hovered_color:          HEX("ffc739"),
            pressed_color:          HEX("f0b325"),
            text_color:             HEX("1d2021"),
            hovered_text_color:     HEX("1d2021"),
            pressed_text_color:     HEX("1d2021"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (6.0, 6.0, 6.0, 6.0),
            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("fabd2f")), (1.0, HEX("ffd648"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("ffc537")), (1.0, HEX("ffde50"))]))),
            pressed_gradient_color: None,
        ),

        // ── Album art ────────────────────────────────────────────────────
        show_album_art:               true,
        album_art_size:               260,
        album_art_border_radius:      (14.0, 14.0, 14.0, 14.0),
        album_art_border_color:       HEX("504945"),
        album_art_border_size:        1.0,
        album_art_spacing:            18,
        album_art_placeholder_color:  HEX("3c3836"),
        album_art_position:           Top,

        // ── Progress bar ─────────────────────────────────────────────────
        progress_bar_height:          4,
        progress_bar_filled_color:    HEX("fabd2f"),
        progress_bar_track_color:     HEX("504945"),
        progress_bar_border_color:    RGBA((0, 0, 0, 0)),
        progress_bar_border_size:     0.0,
        progress_bar_border_radius:   (2.0, 2.0, 2.0, 2.0),
        progress_bar_seekable:        true,
        progress_and_volume_bar_poll_interval_ms: 90,

        // ── Volume bar ───────────────────────────────────────────────────
        volume_bar_width:              90.0,
        volume_bar_height:             4,
        volume_bar_filled_color:       HEX("fabd2f"),
        volume_bar_track_color:        HEX("504945"),
        volume_bar_border_color:       RGBA((0, 0, 0, 0)),
        volume_bar_border_size:        0.0,
        volume_bar_border_radius:      (2.0, 2.0, 2.0, 2.0),
        volume_bar_clickable:          true,
        volume_bar_label_format:       Some("{vol}%"),
        volume_bar_label_position:     Right,
        volume_bar_label_size:         12,
        volume_bar_label_color:        HEX("928374"),
        volume_bar_label_spacing:      8.0,

        // ── Scrollbar ────────────────────────────────────────────────────
        scrollbar:
        (
            show:                    false,
            width:                   6,
            margin:                  2,
            scroller_width:          6,
            border_radius:           (3.0, 3.0, 3.0, 3.0),
            rail_color:              RGBA((0, 0, 0, 0)),
            rail_border_color:       RGBA((0, 0, 0, 0)),
            rail_border_width:       0.0,
            scroller_color:          RGBA((100, 100, 100, 60)),
            scroller_hovered_color:  RGBA((130, 130, 130, 80)),
            scroller_dragging_color: RGBA((160, 160, 160, 100)),
            scroller_border_color:   RGBA((0, 0, 0, 0)),
            scroller_border_width:   0.0,
        ),
    ),


