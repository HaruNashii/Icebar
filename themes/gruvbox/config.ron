// ╭─────────────────────────────────────────────────────────────────────────╮
// │                                                                         │
// │   G R U V B O X   ·   ICEBAR                                            │
// │   Retro groove. Warm. Earthy. Built to last.                            │
// │                                                                         │
// ╰─────────────────────────────────────────────────────────────────────────╯
//
//  PALETTE — official Gruvbox Dark Hard values
//
//    bg0_h  ( 29,  32,  33)  ← hardest background / bar bg
//    bg0    ( 40,  40,  40)  ← dark bg
//    bg1    ( 60,  56,  54)  ← module resting bg
//    bg2    ( 80,  73,  69)  ← hover bg
//    bg3    (102,  92,  84)  ← dim elements
//    bg4    (124, 111, 100)  ← borders if ever used
//
//    fg0    (251, 241, 199)  ← brightest text
//    fg1    (235, 219, 178)  ← primary text
//    fg2    (213, 196, 161)  ← secondary text
//    fg3    (189, 174, 147)  ← dim text
//    fg4    (168, 153, 132)  ← muted text
//
//    bright_red     (251,  73,  52)
//    bright_green   (184, 187,  38)
//    bright_yellow  (250, 189,  47)  ← PRIMARY ACCENT — clock, badge
//    bright_blue    (131, 165, 152)
//    bright_purple  (211, 134, 155)
//    bright_aqua    (142, 192, 124)
//    bright_orange  (254, 128,  25)  ← SECONDARY ACCENT — hover, selected ws
//
//    neutral_red    (204,  36,  29)
//    neutral_green  (152, 151,  26)
//    neutral_yellow (215, 153,  33)
//    neutral_blue   ( 69, 133, 136)
//    neutral_purple (177,  98, 134)
//    neutral_aqua   (104, 157, 106)
//    neutral_orange (214,  93,  14)
//
//  DESIGN:
//    · Top bar, no floating — sits flush against the screen edge
//    · 40px tall — substantial but not heavy
//    · Zero borders — modules are warm bg1 pills on the darker bg0_h bar
//    · Radius 6px — slightly rounded, like worn wooden furniture edges
//    · JetBrains Mono Bold — pairs perfectly with Gruvbox's retro warmth
//    · bright_yellow is the single unifying accent: clock, badge fill, active ws
//    · bright_orange fires ONLY on hover and selected workspace — the groove
//    · Each module group gets its own Gruvbox color — the full palette used

BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display: None,
        bar_position: Up,
        floating_space: 0,
        increased_exclusive_bar_zone: 0,
        bar_check_reload_interval_ms: Some(500),
        bar_side_spaces_size: 8,
        bar_size: (0, 40),
        bar_border_radius: (0., 0., 0., 0.),
        bar_border_size: 0.0,
        bar_border_color: RGB((0, 0, 0)),
        bar_background_color: RGBA((29, 32, 33, 100)),
        font_family: "JetBrains Mono",
        font_style: "Bold",
        spacing_between_all_modules: 6,
        force_static_position_context_menu: None,
        left_modules: [CustomModule(0), HyprWorkspaces, Cpu, Ram],
        center_modules: [Clock],
        right_modules: [MediaPlayerMetaData, MediaPlayerButtons, Network, VolumeOutput, VolumeInput, Tray],
    ),


    // ================= GENERAL STYLE =================
//    general_style:
//    (
//        general_padding: Some(0),
//        general_text_size: Some(15),
//        general_text_orientation: Some(Horizontal),
