BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display:                            None,
        bar_position:                       Up,
        floating_space:                     10,
        increased_exclusive_bar_zone:       10,
        bar_check_reload_interval_ms:       Some(500),
        bar_side_spaces_size:               5,
        bar_size:                           (1900, 35),
        bar_border_radius:                  (8., 8., 8., 8.),
        bar_border_size:                    0.,
        bar_background_color:               RGBA((40, 40, 40, 100)),
        font_family:                        "JetBrains Mono",
        font_style:                         "Bold",
        spacing_between_all_modules:        3,
        force_static_position_context_menu: None,
        left_modules:                       [HyprWorkspaces, CustomModule(0)],
        center_modules:                     [Clock, MediaPlayerMetaData, MediaPlayerButtons],
        right_modules:                      [Tray, Network, VolumeOutput, VolumeInput],
    ),


    // ================= GENERAL STYLE =================
    general_style:
    (
        general_padding:                        Some(0),
        //general_text_size:                      Some(15),
        //general_text_orientation:               Some(Horizontal),
        general_text_color:                     Some(RGB((235, 219, 178))),
        general_button_color:                   Some(RGB((152, 151, 26))),
        general_button_hovered_color:           Some(RGB((84, 55, 44))),
        general_button_hovered_text_color:      Some(RGB((235, 219, 178))),
        general_button_pressed_color:           Some(RGB((84, 55, 44))),
        general_button_gradient_color:          None,
        general_button_pressed_gradient_color:  None,
        general_button_hovered_gradient_color:  None,
        general_button_shadow_color:            None,
        general_button_shadow_x:                Some(0.0),
        general_button_shadow_y:                Some(0.0),
        general_button_shadow_blur:             Some(0.0),
        general_border_color:                   Some(RGBA((40, 40, 0, 100))),
        //general_border_size:                    Some(1.0),
        //general_border_radius:                  Some((3.0, 3.0, 3.0, 3.0)),
        //general_side_separator:                 None,
        //general_side_separator_color:           Some(RGB((75, 75, 75))),
        //general_side_separator_width:           Some(1.0),
        //general_side_separator_height:          Some(16.0),
        //general_alt_padding:                    None,
        //general_alt_text_size:                  None,
        //general_alt_text_orientation:           None,
        general_alt_text_color:                 Some(RGB((235, 219, 178))),
        general_alt_button_color:               Some(RGB((152, 151, 26))),
        general_alt_button_hovered_color:       Some(RGB((84, 55, 44))),
        general_alt_button_hovered_text_color:  Some(RGB((235, 219, 178))),
        general_alt_button_pressed_color:       Some(RGB((84, 55, 44))),
        general_alt_border_color:               Some(RGBA((40, 40, 0, 100))),
        //general_alt_border_size:                None,
        //general_alt_border_radius:              None,
        //general_alt_side_separator:             None,
        //general_alt_side_separator_color:       None,
        //general_alt_side_separator_width:       None,
        //general_alt_side_separator_height:      None,
        general_alt_button_gradient_color:          None,
        general_alt_button_pressed_gradient_color:  None,
        general_alt_button_hovered_gradient_color:  None,
        general_alt_button_shadow_color:            None,
        general_alt_button_shadow_x:                Some(0.0),
        general_alt_button_shadow_y:                Some(0.0),
        general_alt_button_shadow_blur:             Some(0.0),
    ),


    // ================= CLOCK =================
    clock:
    (
        clock_timezones:                        None,
        clock_update_interval:                  400,
        clock_format:                           "󰥔  %H:%M",
        clock_alt_format:                       "󰃭  %a %d %b |  󰥔  %H:%M:%S",
        action_on_left_click_clock:             DefaultAction,
        action_on_right_click_clock:            ShowCalendar,
        clock_side_separator:                   None,
        clock_side_separator_color:             HEX("3d3d3d"),
        clock_side_separator_width:             1.,
        clock_side_separator_height:            18.,
        alt_clock_side_separator:               None,
        alt_clock_side_separator_color:         HEX("3d3d3d"),
        alt_clock_side_separator_width:         1.,
        alt_clock_side_separator_height:        18.,
        clock_button_gradient_color:            None,
        clock_button_hovered_gradient_color:    None,
        clock_button_pressed_gradient_color:    None,
        clock_button_shadow_color:              None,
        clock_button_shadow_x:                  0.0,
        clock_button_shadow_y:                  0.0,
        clock_button_shadow_blur:               0.0,
        alt_clock_button_gradient_color:        None,
        alt_clock_button_hovered_gradient_color: None,
        alt_clock_button_pressed_gradient_color: None,
        clock_padding:                          0,
        clock_text_size:                        15,
        clock_text_color:                       RGB((205, 214, 244)),
        clock_text_orientation:                 Horizontal,
        clock_button_color:                     RGB((49, 50, 68)),
        clock_button_hovered_color:             RGB((203, 166, 247)),
        clock_button_hovered_text_color:        RGB((30, 30, 46)),
        clock_button_pressed_text_color:        RGB((30, 30, 46)),
        clock_button_pressed_color:             RGB((245, 194, 231)),
        clock_border_color:                     HEX("3d3d3d"),
        clock_border_size:                      0.,
        clock_border_radius:                    (6.0, 6.0, 6.0, 6.0),
        alt_clock_padding:                      0,
        alt_clock_text_size:                    15,
        alt_clock_text_color:                   RGB((0, 0, 0)),
        alt_clock_text_orientation:             Horizontal,
        alt_clock_button_color:                 RGB((180, 190, 254)),
        alt_clock_button_hovered_color:         RGB((203, 166, 247)),
        alt_clock_button_hovered_text_color:    RGB((30, 30, 46)),
        alt_clock_button_pressed_text_color:    RGB((30, 30, 46)),
        alt_clock_button_pressed_color:         RGB((245, 194, 231)),
        alt_clock_border_color:                 HEX("3d3d3d"),
        alt_clock_border_size:                  0.,
        alt_clock_border_radius:                (6.0, 6.0, 6.0, 6.0),
    ),


