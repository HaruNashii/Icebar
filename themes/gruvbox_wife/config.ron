        general_button_shadow_y:                Some(0.0),
        general_button_shadow_blur:             Some(0.0),
        general_border_color:                   Some(RGBA((40, 40, 0, 100))),
        //general_border_size:                    Some(1.0),
        //general_border_radius:                  Some((3.0, 3.0, 3.0, 3.0)),
        //general_side_separator:                 None,
        //general_side_separator_color:           Some(RGB((75, 75, 75))),
        //general_side_separator_width:           Some(1.0),
        //general_side_separator_height:          Some(16.0),
        //general_alt_padding:                    None,
        //general_alt_text_size:                  None,
        //general_alt_text_orientation:           None,
        general_alt_text_color:                 Some(RGB((235, 219, 178))),
        general_alt_button_color:               Some(RGB((152, 151, 26))),
        general_alt_button_hovered_color:       Some(RGB((84, 55, 44))),
        general_alt_button_hovered_text_color:  Some(RGB((235, 219, 178))),
        general_alt_button_pressed_color:       Some(RGB((84, 55, 44))),
        general_alt_border_color:               Some(RGBA((40, 40, 0, 100))),
