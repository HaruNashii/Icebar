BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display:                            None,
        bar_position:                       Up,
        floating_space:                     10,
        increased_exclusive_bar_zone:       10,
        bar_check_reload_interval_ms:       Some(500),
        bar_side_spaces_size:               5,
        bar_size:                           (1900, 35),
        bar_border_radius:                  (8., 8., 8., 8.),
        bar_border_size:                    0.,
        bar_background_color:               RGBA((40, 40, 40, 100)),
        font_family:                        "JetBrains Mono",
        font_style:                         "Bold",
        spacing_between_all_modules:        3,
        force_static_position_context_menu: None,
        left_modules:                       [HyprWorkspaces, CustomModule(0)],
        center_modules:                     [Clock, MediaPlayerMetaData, MediaPlayerButtons],
        right_modules:                      [Tray, Network, VolumeOutput, VolumeInput],
    ),


    // ================= GENERAL STYLE =================
    general_style:
    (
        general_padding:                        Some(0),
        //general_text_size:                      Some(15),
        //general_text_orientation:               Some(Horizontal),
        general_text_color:                     Some(RGB((235, 219, 178))),
        general_button_color:                   Some(RGB((152, 151, 26))),
        general_button_hovered_color:           Some(RGB((84, 55, 44))),
        general_button_hovered_text_color:      Some(RGB((235, 219, 178))),
        general_button_pressed_color:           Some(RGB((84, 55, 44))),
        general_button_gradient_color:          None,
        general_button_pressed_gradient_color:  None,
        general_button_hovered_gradient_color:  None,
        general_button_shadow_color:            None,
