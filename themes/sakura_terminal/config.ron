    // ================= CUSTOM MODULE =================
    custom_module:
    (
        custom_modules_spacing: 8,
        custom_modules:
        [
            (
                name: "季節",
                text: "",
                text_size: 14,
                text_color: RGB((252, 248, 241)),
                text_orientation: Horizontal,
                height: 28,
                button_color: RGB((220, 130, 150)),
                button_hovered_color: RGB((210, 105, 60)),
                button_hovered_text_color: RGB((252, 248, 241)),
                button_pressed_color: RGB((170, 80, 40)),
                border_color: RGB((200, 110, 130)),
                border_size: 1.0,
                border_radius: (5.0, 5.0, 5.0, 5.0),
                display_err_output_if_failed: false,
                dont_show_if_any_output_is_empty: true,
                use_output_as_text: false,
                use_continous_output_as_text: true,
                all_output_as_text_format: "{continous_output}",
                output_text_limit_len: 12,
                command_to_exec_on_left_click: ["wofi", "--show", "drun"],
                command_to_exec_on_right_click: ["kitty", "yazi"],
                continous_command_interval: 60000,
                continous_command: ["bash", "-c", "m=$(date +%-m); if [ $m -ge 3 ] && [ $m -le 5 ]; then echo '春  sakura'; elif [ $m -ge 6 ] && [ $m -le 8 ]; then echo '夏  natsu'; elif [ $m -ge 9 ] && [ $m -le 11 ]; then echo '秋  aki'; else echo '冬  fuyu'; fi" ],
            ),
            (
                name: "稼働時間",
                text: "",
                text_size: 13,
                text_color: RGB((110, 145, 100)),
                text_orientation: Horizontal,
                height: 28,
                button_color: RGB((244, 239, 230)),
                button_hovered_color: RGB((210, 105, 60)),
                button_hovered_text_color: RGB((252, 248, 241)),
                button_pressed_color: RGB((80, 110, 72)),
                border_color: RGB((185, 160, 130)),
                border_size: 1.0,
                border_radius: (5.0, 5.0, 5.0, 5.0),
                display_err_output_if_failed: false,
                dont_show_if_any_output_is_empty: true,
                use_output_as_text: false,
                use_continous_output_as_text: true,
                all_output_as_text_format: "起動 {continous_output}",
                output_text_limit_len: 20,
                command_to_exec_on_left_click: ["kitty", "bash", "-c", "neofetch; read -n 1"],
                command_to_exec_on_right_click: ["kitty", "bash", "-c", "neofetch; read -n 1"],
                continous_command_interval: 30000,
		continous_command: ["bash", "-c", "awk '{s=$1; d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60); if(d>0) printf d\"d·\"h\"h·\"m\"m\"; else if(h>0) printf h\"h·\"m\"m\"; else printf m\"m\"}' /proc/uptime"],
            ),
        ],
    ),


