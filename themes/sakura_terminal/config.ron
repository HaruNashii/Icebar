            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("d2693c")), (1.0, HEX("b95023"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("da7144")), (1.0, HEX("c1582b"))]))),
            pressed_gradient_color: None,
