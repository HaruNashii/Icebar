// ╭─────────────────────────────────────────────────────────────────────────╮
// │                                                                         │
// │   M I N I M A L   B L A C K   ·   ICEBAR                               │
// │   Ultra-thin. Full width. Flush top. Pure black.                       │
// │   Everything dissolves into the bar — no module separation.            │
// │   Bracket notation. Text only. dwm/i3bar aesthetic.                    │
// │                                                                         │
// ╰─────────────────────────────────────────────────────────────────────────╯
//
//  PALETTE
//
//    bg          (  8,   8,   8)  ← pure near-black
//    fg          (220, 220, 220)  ← primary text — slightly off-white
//    fg_dim      (120, 120, 120)  ← inactive workspaces, dim info
//    fg_muted    ( 70,  70,  70)  ← almost invisible separators
//    accent      (255, 255, 255)  ← selected workspace text, clock
//    red         (200,  80,  80)  ← muted audio — the one alarm color

BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display: None,
        bar_position: Up,
        floating_space: 0,
        increased_exclusive_bar_zone: 0,
        bar_check_reload_interval_ms: Some(500),
        bar_side_spaces_size: 6,
        bar_size: (0, 22),
        bar_border_radius: (0., 0., 0., 0.),
        bar_border_size: 0.0,
        bar_border_color: RGB((0, 0, 0)),
        bar_background_color: RGBA((8, 8, 8, 100)),
        font_family: "JetBrainsMono Nerd Font",
        font_style: "Regular",
        spacing_between_all_modules: 4,
        force_static_position_context_menu: None,
        left_modules: [NiriWorkspaces],
        center_modules: [Clock],
        right_modules: [Network, VolumeOutput, Tray],
    ),


    // ================= GENERAL STYLE =================
//    general_style:
