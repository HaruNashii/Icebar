        alt_clock_button_hovered_text_color: RGB((255, 255, 255)),
        alt_clock_button_pressed_color: RGB((4, 4, 4)),
        alt_clock_border_color: RGB((0, 0, 0)),
        alt_clock_border_size: 0.0,
        alt_clock_border_radius: (0.0, 0.0, 0.0, 0.0),
    ),


