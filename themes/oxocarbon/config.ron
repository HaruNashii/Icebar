            border_size:            0.0,
            border_radius:          (20.0, 20.0, 20.0, 20.0),
            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("f0b300")), (1.0, HEX("ffcc19"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("f8bb08")), (1.0, HEX("ffd421"))]))),
            pressed_gradient_color: None,
