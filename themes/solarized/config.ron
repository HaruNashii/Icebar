// ╭─────────────────────────────────────────────────────────────────────────╮
// │                                                                         │
// │   S O L A R I Z E D   L I G H T   ·   ICEBAR                      	     │
// │   Full width. Top. Light variant. Retro toolbar energy.                 │
// │   v1 was dark, bottom, fixed-width island. This is none of that.        │
// │                                                                         │
// ╰─────────────────────────────────────────────────────────────────────────╯
//
//  PALETTE — Solarized Light (same hue values, swapped bg/fg roles)
//
//    base3      (253, 246, 227)  ← lightest bg / bar background
//    base2      (238, 232, 213)  ← module resting bg — a step darker
//    base1      (147, 161, 161)  ← dim text / secondary
//    base0      (101, 123, 131)  ← body text
//    base00     (101, 123, 131)  ← same as base0 in light
//    base01     ( 88, 110, 117)  ← emphasized text
//    base02     (  7,  54,  66)  ← stronger contrast elements
//    base03     (  0,  43,  54)  ← darkest — hover fill, inverted
//
//    yellow     (181, 137,   0)  ← clock
//    orange     (203,  75,  22)  ← badge fill / PRIMARY warm accent
//    red        (220,  50,  47)  ← muted
//    magenta    (211,  54, 130)  ← media
//    violet     (108, 113, 196)  ← workspaces active
//    blue       ( 38, 139, 210)  ← network
//    cyan       ( 42, 161, 152)  ← volume
//    green      (133, 153,   0)  ← sys stats
//
//    · FULL WIDTH TOP BAR — bar_size: (0, 38), floating_space: 0
//      Edge to edge. Flush. No island. Never done before in Solarized.
//    · bar_border_radius: (0., 0., 0., 0.) — flat, not rounded
//    · LIGHT background (base3 cream) — only the second light theme in collection
//    · Module bg = base2 — visibly darker than bar, like raised buttons
//      This creates the "retro toolbar" depth even without borders
//    · Hover = base03 (near-black fill) with base3 (cream) text
//      Inverted on hover — dramatic, high contrast, intentional retro click
//    · Font: "Source Code Pro" Bold — different from both previous versions
//    · Layout: LEFT=Badge+Workspaces   CENTER=Clock   RIGHT=Cpu+Ram+Vol+Net+Tray
//    · Badge uses ORANGE fill with cream text — warm and punchy on the pale bar
//    · Clock uses yellow — same as v1 but now on a light bg, reads totally different
//    · Workspaces use violet fill on active — clear on cream, never tried before

BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display: None,
        bar_position: Up,
        floating_space: 0,
        increased_exclusive_bar_zone: 0,
        bar_check_reload_interval_ms: Some(500),
        bar_side_spaces_size: 8,
        bar_size: (0, 38),
        bar_border_radius: (0., 0., 0., 0.),
        bar_border_size: 0.0,
        bar_border_color: RGB((0, 0, 0)),
        bar_background_color: RGBA((253, 246, 227, 100)),
        font_family: "Source Code Pro",
        font_style: "Bold",
        spacing_between_all_modules: 5,
        force_static_position_context_menu: None,
        left_modules: [CustomModule(0), NiriWorkspaces],
        center_modules: [Clock],
        right_modules: [VolumeOutput, VolumeInput, Network, Tray],
    ),


    // ================= GENERAL STYLE =================
