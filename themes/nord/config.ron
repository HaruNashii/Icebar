    // ================= VOLUME MIXER OUTPUT =================
    volume_output_mixer:
    (
    	mixer_window_size: 		(680, 430),
	mixer_background_color:		RGB((46, 52, 64)),
        mixer_background_border_color:  RGBA((0, 0, 0, 0)),
	mixer_background_border_size:	0.0,
	mixer_background_border_radius:	(8., 8., 8., 8.),
	mixer_padding:			10,
	mixer_section_spacing:		8,
	mixer_show_only_active_devices: false,
	// Available options: Up, Down, Left, Right
	// Up    = [Devices]      Down  = [Applications]   Left  = [Devices][Applications]   Right = [Applications][Devices]
	//         [Applications]         [Devices]
	categories_position:            Left,

	scrollbar:
	(
		show:                    true,
            	width:                   6,
            	margin:                  2,
            	scroller_width:          6,
            	border_radius:           (3.0, 3.0, 3.0, 3.0),
		rail_border_width:       0.0,
            	rail_border_color:       RGBA((0, 0, 0, 0)),
		rail_color:              RGBA((0, 0, 0, 0)),
            	scroller_color:          RGBA((136, 192, 208, 50)),
            	scroller_hovered_color:  RGBA((136, 192, 208, 70)),
            	scroller_dragging_color: RGBA((136, 192, 208, 90)),
            	scroller_border_color:   RGBA((0, 0, 0, 0)),
            	scroller_border_width:   0.0,
	),

	device_category: 
	(
		show:			true,
		show_header:		true,
		start_collapsed: 	false,
		header_label:		"  Devices",
		header_collapsed_label: "›",
		header_expanded_label:	"‹",
		header_text_size:	13,
		header_arrow_text_size:	13,
		header_button_height:	26,
		spacing:		15,
		header_text_color:	RGB((136, 192, 208)),
		header_button_style:
		(
		        color:              	RGB((67, 76, 94)),
            		hovered_color:      	RGB((76, 86, 106)),
            		pressed_color:      	RGB((59, 66, 82)),
            		text_color:         	RGB((229, 233, 240)),
            		hovered_text_color: 	RGB((229, 233, 240)),
            		pressed_text_color: 	RGB((229, 233, 240)),
            		border_color:       	RGBA((0, 0, 0, 0)),
            		border_size:        	0.0,
            		border_radius:      	(8., 8., 8., 8.),
		)
	),

	app_category: 
	(
		show:			true,
		show_header:		true,
		start_collapsed: 	false,
		header_label:		"  Applications",
		header_collapsed_label: "›",
		header_expanded_label:	"‹",
		header_text_size:	13,
		header_arrow_text_size:	13,
		header_button_height:	26,
		spacing:		15,
		header_text_color:	RGB((136, 192, 208)),
		header_button_style:
		(
		        color:              	RGB((67, 76, 94)),
            		hovered_color:      	RGB((76, 86, 106)),
            		pressed_color:      	RGB((59, 66, 82)),
            		text_color:         	RGB((229, 233, 240)),
            		hovered_text_color: 	RGB((229, 233, 240)),
            		pressed_text_color: 	RGB((229, 233, 240)),
            		border_color:       	RGBA((0, 0, 0, 0)),
            		border_size:        	0.0,
            		border_radius:      	(8., 8., 8., 8.),
		)
	),
	
	device_row:
	(
	    device_row_order:			[DeviceButton, Slider, Mute],
            show_only_default_device_name: 	false,

            row_height:                 30,
            row_spacing:                5,
            name_text_size:             13,
            name_text_color:            RGB((229, 233, 240)),
            name_max_chars:             16,
	    device_name_button_width:   140,

            volume_step:                1,
            slider_width:               220.0,
            slider_style:               
	    (
            	rail_width:           4.0,
		rail_color:           RGB((67, 76, 94)),
		rail_filled_color:    RGB((136, 192, 208)),
