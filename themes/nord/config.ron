// ┌─────────────────────────────────────────────────────────────────────────┐
// │   N O R D   ·   ICEBAR CONFIG  v2                                       │
// │   Same palette. Completely rebuilt.                                     │
// └─────────────────────────────────────────────────────────────────────────┘
//
//  PALETTE — official Nord values, unchanged
//
//    nord0   ( 46,  52,  64)  ← deepest bg / pressed
//    nord1   ( 59,  66,  82)  ← bar background
//    nord2   ( 67,  76,  94)  ← module resting bg
//    nord3   ( 76,  86, 106)  ← hover bg / subtle fill
//    nord4   (216, 222, 233)  ← secondary text
//    nord5   (229, 233, 240)  ← primary text
//    nord6   (236, 239, 244)  ← brightest text (clock)
//    nord7   (143, 188, 187)  ← teal  (media)
//    nord8   (136, 192, 208)  ← glacier blue  ← MAIN ACCENT
//    nord9   (129, 161, 193)  ← muted blue (volume)
//    nord10  ( 94, 129, 172)  ← deep blue (pressed accent)
//    nord11  (191,  97, 106)  ← red (muted audio only)
//    nord14  (163, 190, 140)  ← green (network ok)
//
//  DESIGN DECISIONS v2:
//    · NO borders anywhere — zero border_size throughout
//      Every module is a clean pill of color, no outlines fighting each other
//    · Font: JetBrains Mono Bold — thick, crisp, reads well at small sizes
//    · Bar height 38px, floating 6px from top with generous side padding
//    · ALL modules use the same border_size: 0.0 — full consistency
//    · Clock is NOT special-cased — it uses the same pill style as everything
//      else, just with nord8 text so it reads as the accent centerpiece
//    · Spacing between modules: 8px — room to breathe without being loose
//    · Hover = nord3 fill (subtle lift), not a color change — arctic restraint
//    · Only the launcher badge breaks the rule: solid nord8 fill, the one
//      warm anchor the eye can return to

BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display: None,
        bar_position: Up,
        floating_space: 6,
        increased_exclusive_bar_zone: 0,
        bar_check_reload_interval_ms: Some(500),
        bar_side_spaces_size: 10,
        bar_size: (0, 38),
        bar_border_radius: (8., 8., 8., 8.),
        bar_border_size: 0.0,
        bar_border_color: RGB((76, 86, 106)),
        bar_background_color: RGBA((59, 66, 82, 100)),
        font_family: "JetBrains Mono",
        font_style: "Bold",
        spacing_between_all_modules: 8,
        force_static_position_context_menu: None,
        left_modules: [CustomModule(0), HyprWorkspaces],
        center_modules: [Clock, MediaPlayerMetaData],
        right_modules: [Network, VolumeOutput, VolumeInput, Tray],
    ),


    // ================= GENERAL STYLE =================
//    general_style:
//    (
//        general_padding: Some(0),
//        general_text_size: Some(15),
//        general_text_orientation: Some(Horizontal),
//        general_text_color: Some(HEX("FFFFFF")),
//        general_button_color: Some(HEX("322d3c")),
//        general_button_hovered_color: Some(RGB((130, 35, 70))),
//        general_button_hovered_text_color: Some(RGB((255, 255, 255))),
//        general_button_pressed_color: Some(RGB((80, 25, 45))),
//        general_button_gradient_color: None,
//        general_button_pressed_gradient_color: None,
//        general_button_hovered_gradient_color: None,
//        general_border_color: Some(RGB((120, 80, 130))),
//        general_border_size: Some(1.0),
//        general_border_radius: Some((3.0, 3.0, 3.0, 3.0)),
//        general_side_separator: None,
//        general_side_separator_color: Some(RGB((75, 75, 75))),
//        general_side_separator_width: Some(1.0),
//        general_side_separator_height: Some(16.0),
//        general_alt_padding: None,
//        general_alt_text_size: None,
//        general_alt_text_orientation: None,
//        general_alt_text_color: None,
//        general_alt_button_color: None,
//        general_alt_button_hovered_color: None,
//        general_alt_button_hovered_text_color: None,
//        general_alt_button_pressed_color: None,
//        general_alt_border_color: None,
//        general_alt_border_size: None,
//        general_alt_border_radius: None,
//        general_alt_side_separator: None,
//        general_alt_side_separator_color: None,
//        general_alt_side_separator_width: None,
//        general_alt_side_separator_height: None,
//        general_alt_button_gradient_color: None,
//        general_alt_button_pressed_gradient_color: None,
//        general_alt_button_hovered_gradient_color: None,
//    ),


    // ================= CLOCK =================
    clock:
    (
        clock_timezones: None,
        clock_update_interval: 400,
        clock_format: "󰥔  %H:%M",
        clock_alt_format: "󰃭  %a %d %b    󰥔  %H:%M:%S",
        action_on_left_click_clock: DefaultAction,
        action_on_right_click_clock: ShowCalendar,
        clock_side_separator: None,
        clock_side_separator_color: RGB((75, 75, 75)),
        clock_side_separator_width: 1.,
        clock_side_separator_height: 16.,
        alt_clock_side_separator: None,
        alt_clock_side_separator_color: RGB((75, 75, 75)),
        alt_clock_side_separator_width: 1.,
        alt_clock_side_separator_height: 16.,
        clock_button_hovered_gradient_color: None,
        clock_button_pressed_gradient_color: None,
        alt_clock_button_gradient_color: None,
        alt_clock_button_hovered_gradient_color: None,
        alt_clock_button_pressed_gradient_color: None,
        clock_padding: 0,
        clock_text_size: 15,
        clock_text_color: RGB((136, 192, 208)),
        clock_text_orientation: Horizontal,
        clock_button_color: RGB((67, 76, 94)),
        clock_button_hovered_color: RGB((76, 86, 106)),
        clock_button_hovered_text_color: RGB((136, 192, 208)),
        clock_button_pressed_color: RGB((46, 52, 64)),
        clock_border_color: RGB((0, 0, 0)),
        clock_border_size: 0.0,
        clock_border_radius: (6.0, 6.0, 6.0, 6.0),
        alt_clock_padding: 0,
        alt_clock_text_size: 13,
        alt_clock_text_color: RGB((136, 192, 208)),
        alt_clock_text_orientation: Horizontal,
        alt_clock_button_color: RGB((67, 76, 94)),
        alt_clock_button_hovered_color: RGB((76, 86, 106)),
        alt_clock_button_hovered_text_color: RGB((136, 192, 208)),
        alt_clock_button_pressed_color: RGB((46, 52, 64)),
        alt_clock_border_color: RGB((0, 0, 0)),
        alt_clock_border_size: 0.0,
        alt_clock_border_radius: (6.0, 6.0, 6.0, 6.0),
    ),


    // ================= MEDIA PLAYER WINDOW =================
    media_player_window:
    (
        // ── Window ───────────────────────────────────────────────────────
        window_size:                  (340, 500),
        window_padding:               18,
        background_color:             HEX("2e3440"),
        background_border_color:      HEX("4c566a"),
        background_border_size:       1.0,
        background_border_radius:     (10.0, 10.0, 10.0, 10.0),

        // ── Layout ───────────────────────────────────────────────────────
        row_order:                    [Fill, Prev, PlayPause, Next, Fill],
        row_height:                   54,
        row_spacing:                  14,
        section_spacing:              18,

        // ── Metadata (title) ────────────────────────────────────────────
        metadata_text_size:           15,
        metadata_text_color:          HEX("eceff4"),
        metadata_max_chars:           80,
        metadata_button_style:
        (
            color:                  RGBA((0, 0, 0, 0)),
            hovered_color:          RGBA((0, 0, 0, 0)),
            pressed_color:          RGBA((0, 0, 0, 0)),
            text_color:             HEX("eceff4"),
            hovered_text_color:     HEX("eceff4"),
            pressed_text_color:     HEX("8191a0"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (0.0, 0.0, 0.0, 0.0),
            gradient_color:         None,
            hovered_gradient_color: None,
            pressed_gradient_color: None,
        ),
        metadata_button_height:       24,
        metadata_button_width:        0.0,

        // ── Transport button labels ─────────────────────────────────────
        prev_label:     "󰒮",
        play_label:     "▶",
        pause_label:    "󰏤",
        next_label:     "󰒭",
        vol_down_label: "󰝞",
        vol_up_label:   "󰝝",

        // ── Transport button styles ─────────────────────────────────────
        button_text_size:             16,
        button_width:                 40,
        button_height:                40,
        button_style:
        (
            color:                  RGBA((0, 0, 0, 0)),
            hovered_color:          HEX("434c5e"),
            pressed_color:          HEX("394254"),
            text_color:             HEX("eceff4"),
            hovered_text_color:     HEX("eceff4"),
            pressed_text_color:     HEX("8191a0"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (8.0, 8.0, 8.0, 8.0),
            gradient_color:         None,
            hovered_gradient_color: None,
            pressed_gradient_color: None,
        ),
        play_button_style:
        (
            color:                  HEX("88c0d0"),
            hovered_color:          HEX("92cada"),
            pressed_color:          HEX("7eb6c6"),
            text_color:             HEX("2e3440"),
            hovered_text_color:     HEX("2e3440"),
            pressed_text_color:     HEX("2e3440"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (8.0, 8.0, 8.0, 8.0),
            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("88c0d0")), (1.0, HEX("a1d9e9"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("90c8d8")), (1.0, HEX("a9e1f1"))]))),
            pressed_gradient_color: None,
        ),
        pause_button_style:
        (
            color:                  HEX("88c0d0"),
            hovered_color:          HEX("92cada"),
            pressed_color:          HEX("7eb6c6"),
            text_color:             HEX("2e3440"),
            hovered_text_color:     HEX("2e3440"),
            pressed_text_color:     HEX("2e3440"),
            border_color:           RGBA((0, 0, 0, 0)),
            border_size:            0.0,
            border_radius:          (8.0, 8.0, 8.0, 8.0),
            gradient_color:         Some(Gradient((180.0, [(0.0, HEX("88c0d0")), (1.0, HEX("a1d9e9"))]))),
            hovered_gradient_color: Some(Gradient((180.0, [(0.0, HEX("90c8d8")), (1.0, HEX("a9e1f1"))]))),
            pressed_gradient_color: None,
        ),

        // ── Album art ────────────────────────────────────────────────────
        show_album_art:               true,
        album_art_size:               260,
        album_art_border_radius:      (14.0, 14.0, 14.0, 14.0),
        album_art_border_color:       HEX("4c566a"),
        album_art_border_size:        1.0,
        album_art_spacing:            18,
        album_art_placeholder_color:  HEX("3b4252"),
        album_art_position:           Top,

        // ── Progress bar ─────────────────────────────────────────────────
        progress_bar_height:          4,
        progress_bar_filled_color:    HEX("88c0d0"),
        progress_bar_track_color:     HEX("434c5e"),
        progress_bar_border_color:    RGBA((0, 0, 0, 0)),
        progress_bar_border_size:     0.0,
        progress_bar_border_radius:   (2.0, 2.0, 2.0, 2.0),
        progress_bar_seekable:        true,
        progress_and_volume_bar_poll_interval_ms: 90,

        // ── Volume bar ───────────────────────────────────────────────────
        volume_bar_width:              90.0,
        volume_bar_height:             4,
        volume_bar_filled_color:       HEX("88c0d0"),
        volume_bar_track_color:        HEX("434c5e"),
        volume_bar_border_color:       RGBA((0, 0, 0, 0)),
        volume_bar_border_size:        0.0,
        volume_bar_border_radius:      (2.0, 2.0, 2.0, 2.0),
        volume_bar_clickable:          true,
        volume_bar_label_format:       Some("{vol}%"),
        volume_bar_label_position:     Right,
        volume_bar_label_size:         12,
        volume_bar_label_color:        HEX("8191a0"),
        volume_bar_label_spacing:      8.0,

        // ── Scrollbar ────────────────────────────────────────────────────
        scrollbar:
        (
            show:                    false,
            width:                   6,
            margin:                  2,
            scroller_width:          6,
            border_radius:           (3.0, 3.0, 3.0, 3.0),
            rail_color:              RGBA((0, 0, 0, 0)),
            rail_border_color:       RGBA((0, 0, 0, 0)),
            rail_border_width:       0.0,
            scroller_color:          RGBA((100, 100, 100, 60)),
            scroller_hovered_color:  RGBA((130, 130, 130, 80)),
            scroller_dragging_color: RGBA((160, 160, 160, 100)),
            scroller_border_color:   RGBA((0, 0, 0, 0)),
            scroller_border_width:   0.0,
        ),
    ),


    // ================= CALENDAR =================
    //
    //  Palette mapping:
    //    background          → nord0  RGBA with slight transparency
    //    nav / arrow buttons → nord2  resting,  nord3  hover,  nord0  pressed
    //    nav active (month)  → nord10 resting,  nord8  hover,  nord0  pressed
    //    day cells           → nord2  resting,  nord3  hover,  nord0  pressed
    //    today cell          → nord8  resting,  nord7  hover,  nord10 pressed
    //    selected cell       → nord10 resting,  nord8  hover,  nord0  pressed
    //    overflow days       → very dim nord1, muted nord3 text
    //    weekday header text → nord4
    //    week numbers        → nord9
    //    month / year cells  → nord2  resting,  nord3  hover,  nord0  pressed
    //    current month/year  → nord10 resting,  nord8  hover,  nord0  pressed
    //    all text on accent  → nord6 (brightest) so it stays readable
    //
    calendar_window:
    (
        calendar_window_size: (329, 300),

        calendar_background_color: RGBA((46, 52, 64, 97)),
        calendar_background_border_color: RGB((67, 76, 94)),
        calendar_background_border_size: 0.0,
        calendar_background_border_radius: (8., 8., 8., 8.),
        calendar_padding: 10,

        // ── Navigation row (month / year label buttons) ──────────────────
        calendar_nav_spacing_y: 0,
        calendar_nav_position: Above,
        calendar_nav_grid_spacing: 6,
        calendar_nav_spacing: 4,
        calendar_nav_button_height: 26,
        calendar_nav_button_width: 80,
        calendar_nav_text_size: 13,
        calendar_nav_button_style:
        (
            color:              RGB((67, 76, 94)),
            hovered_color:      RGB((76, 86, 106)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((216, 222, 233)),
            hovered_text_color: RGB((236, 239, 244)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),
        calendar_nav_active_button_style:
        (
            color:              RGB((94, 129, 172)),
            hovered_color:      RGB((136, 192, 208)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((236, 239, 244)),
            hovered_text_color: RGB((46, 52, 64)),
            pressed_text_color: RGB((216, 222, 233)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // ── Arrow buttons ( ‹ / › ) ──────────────────────────────────────
        calendar_prev_label: "‹",
        calendar_next_label: "›",
        calendar_arrow_button_height: 26,
        calendar_arrow_button_width: 26,
        calendar_arrow_text_size: 18,
        calendar_arrow_button_style:
        (
            color:              RGB((67, 76, 94)),
            hovered_color:      RGB((76, 86, 106)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((136, 192, 208)),
            hovered_text_color: RGB((236, 239, 244)),
            pressed_text_color: RGB((216, 222, 233)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // ── Day grid ─────────────────────────────────────────────────────
        calendar_total_day_cells: 35,
        calendar_month_spacing_y: 5,
        calendar_show_weekday_header: true,
        calendar_weekday_labels: ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"],
        calendar_weekday_header_text_size: 11,
        calendar_weekday_header_text_color: RGB((216, 222, 233)),
        calendar_show_week_numbers: false,
        calendar_week_number_text_size: 11,
        calendar_week_number_text_color: RGB((129, 161, 193)),
        calendar_first_week_day: Monday,
        calendar_day_cell_width: 40,
        calendar_day_cell_height: 38,
        calendar_grid_spacing: 2,
        calendar_day_text_size: 12,

        // normal day
        calendar_day_button_style:
        (
            color:              RGB((67, 76, 94)),
            hovered_color:      RGB((76, 86, 106)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((216, 222, 233)),
            hovered_text_color: RGB((236, 239, 244)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // today  →  nord8 accent fill
        calendar_today_button_style:
        (
            color:              RGB((136, 192, 208)),
            hovered_color:      RGB((143, 188, 187)),
            pressed_color:      RGB((94, 129, 172)),
            text_color:         RGB((46, 52, 64)),
            hovered_text_color: RGB((46, 52, 64)),
            pressed_text_color: RGB((236, 239, 244)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // selected day  →  nord10 deep blue
        calendar_selected_day_button_style:
        (
            color:              RGB((94, 129, 172)),
            hovered_color:      RGB((136, 192, 208)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((236, 239, 244)),
            hovered_text_color: RGB((46, 52, 64)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // overflow days (prev / next month)  →  very dim
        calendar_show_overflow_days_prev_month: true,
        calendar_show_overflow_days_next_month: true,
        calendar_overflow_day_button_style:
        (
            color:              RGBA((59, 66, 82, 60)),
            hovered_color:      RGBA((67, 76, 94, 80)),
            pressed_color:      RGBA((46, 52, 64, 60)),
            text_color:         RGB((76, 86, 106)),
            hovered_text_color: RGB((129, 161, 193)),
            pressed_text_color: RGB((129, 161, 193)),
            border_color:       RGBA((0, 0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        calendar_day_click_action: HighlightOnly,

        // ── Year view (month cells) ───────────────────────────────────────
        calendar_year_spacing_y: 45,
        calendar_month_cell_width: 68,
        calendar_month_cell_height: 36,
        calendar_year_grid_columns: 3,
        calendar_year_grid_spacing: 4,
        calendar_month_text_size: 12,
        calendar_month_labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],

        // normal month cell
        calendar_month_button_style:
        (
            color:              RGB((67, 76, 94)),
            hovered_color:      RGB((76, 86, 106)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((216, 222, 233)),
            hovered_text_color: RGB((236, 239, 244)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // current month  →  nord10 accent
        calendar_current_month_button_style:
        (
            color:              RGB((94, 129, 172)),
            hovered_color:      RGB((136, 192, 208)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((236, 239, 244)),
            hovered_text_color: RGB((46, 52, 64)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // ── Decade view (year cells) ──────────────────────────────────────
        calendar_decade_spacing_y: 45,
        calendar_year_cell_width: 68,
        calendar_year_cell_height: 36,
        calendar_decade_grid_columns: 3,
        calendar_decade_grid_spacing: 4,
        calendar_year_text_size: 12,

        // normal year cell
        calendar_year_button_style:
        (
            color:              RGB((67, 76, 94)),
            hovered_color:      RGB((76, 86, 106)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((216, 222, 233)),
            hovered_text_color: RGB((236, 239, 244)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),

        // current year  →  nord10 accent
        calendar_current_year_button_style:
        (
            color:              RGB((94, 129, 172)),
            hovered_color:      RGB((136, 192, 208)),
            pressed_color:      RGB((46, 52, 64)),
            text_color:         RGB((236, 239, 244)),
            hovered_text_color: RGB((46, 52, 64)),
            pressed_text_color: RGB((229, 233, 240)),
            border_color:       RGB((0, 0, 0)),
            border_size:        0.0,
            border_radius:      (4., 4., 4., 4.),
        ),
    ),


    // ================= VOLUME OUTPUT =================
    volume_output:
    (
        output_volume_format:
        (
            "󰕿  ---",
            "󰕿  {}%",
            "󰖀  {}%",
            "󰖀  {}%",
            "󰕾  {}%",
            "󰕾  {}%",
        ),
        incremental_steps_output: 5,
        action_on_left_click_volume_output: DefaultAction,
        action_on_right_click_volume_output: ShowVolumeOutputMixer,
        volume_output_padding: 0,
        volume_output_text_size: 13,
        volume_output_text_color: RGB((129, 161, 193)),
        volume_output_text_orientation: Horizontal,
        volume_output_button_color: RGB((67, 76, 94)),
        volume_output_button_hovered_color: RGB((76, 86, 106)),
        volume_output_button_hovered_text_color: RGB((129, 161, 193)),
        volume_output_button_pressed_color: RGB((46, 52, 64)),
        volume_output_border_color: RGB((0, 0, 0)),
        volume_output_border_size: 0.0,
        volume_output_border_radius: (6.0, 6.0, 6.0, 6.0),
        volume_output_side_separator: None,
        volume_output_side_separator_color: RGB((75, 75, 75)),
        volume_output_side_separator_width: 1.,
        volume_output_side_separator_height: 20.,
        volume_output_button_gradient_color: None,
        volume_output_button_hovered_gradient_color: None,
        volume_output_button_pressed_gradient_color: None,
    ),


    // ================= MUTED VOLUME OUTPUT =================
    muted_volume_output:
    (
        muted_volume_output_format: "󰝟  Muted",
        muted_volume_output_padding: 0,
        muted_volume_output_text_size: 13,
        muted_volume_output_text_color: RGB((191, 97, 106)),
        muted_volume_output_text_orientation: Horizontal,
