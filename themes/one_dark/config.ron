// ╭─────────────────────────────────────────────────────────────────────────╮
// │                                                                         │
// │   O N E   D A R K   ·   ICEBAR                                          │
// │   Top full-width. 52px tall. Bolted. App-bar proportions.              │
// │   The tallest horizontal bar in the collection.                        │
// │                                                                         │
// ╰─────────────────────────────────────────────────────────────────────────╯
//
//  PALETTE — One Dark (Atom editor original)
//
//    bg          ( 40,  44,  52)  ← bar background
//    bg_alt      ( 33,  37,  43)  ← deeper — pressed states
//    bg_hl       ( 49,  53,  61)  ← module resting bg
//    bg_hover    ( 62,  68,  81)  ← hover
//    border      ( 58,  64,  76)  ← structural (unused — borderless)
//
//    fg          (171, 178, 191)  ← primary text
//    fg_dim      ( 92,  99, 112)  ← muted / inactive text
//    fg_bright   (220, 223, 228)  ← emphasized / selected text
//
//    red         (224,  82,  82)  ← muted audio
//    orange      (209, 154, 102)  ← volume
//    yellow      (229, 192, 123)  ← clock (warm anchor)
//    green       (152, 195, 121)  ← network
//    cyan        ( 86, 182, 194)  ← secondary info
//    blue        ( 97, 175, 239)  ← PRIMARY ACCENT — badge, workspaces
//    magenta     (198, 120, 221)  ← media player
//    dark_red    (190,  80,  70)  ← alt / deep accent (unused)
//
//  DESIGN — never done before in this collection:
//    · TOP FULL WIDTH 52px BAR — bar_size: (0, 52)
//      Tallest horizontal bar. Feels like a proper app bar, not a status line.
//    · floating_space: 0 — bolted flush to top edge
//    · bar_border_radius: (0., 0., 0., 0.) — hard frame
//    · bar_side_spaces_size: 16 — generous, matches the tall proportions
//    · spacing_between_all_modules: 10 — all modules breathe
//    · Module radius: (8., 8., 8., 8.) — subtle rounding inside the hard frame
//    · Font: "Cascadia Code" Bold — One Dark's most popular font pairing
//    · Font size: 14 everywhere — larger than most configs (52px has the room)
//    · Clock: 18px — the largest horizontal clock in the collection
//    · Layout breaks previous patterns completely:
//        LEFT   : Badge  HyprWorkspaces  (opens left, clean and wide)
//        CENTER : MediaPlayerMetaData + MediaPlayerButtons together
//        RIGHT  : Network  VolumeOutput  Clock  Tray
//    · Clock is the RIGHTMOST item (not center, not left) — reads as timestamp
//    · Media occupies the entire CENTER — album/track front and center
//    · Blue anchors the badge and active workspace
//    · Yellow is the warm timestamp at the far right
//    · Magenta owns the media center entirely

BarConfig
(

    // ================= GENERAL =================
    general:
    (
        display: None,
        bar_position: Up,
        floating_space: 0,
        increased_exclusive_bar_zone: 0,
        bar_check_reload_interval_ms: Some(500),
        bar_side_spaces_size: 16,
        bar_size: (0, 52),
        bar_border_radius: (0., 0., 0., 0.),
        bar_border_size: 0.0,
        bar_border_color: RGB((0, 0, 0)),
        bar_background_color: RGBA((40, 44, 52, 100)),
        font_family: "Cascadia Code",
        font_style: "Bold",
        spacing_between_all_modules: 10,
        force_static_position_context_menu: None,
        left_modules: [CustomModule(0), NiriWorkspaces],
        center_modules: [MediaPlayerButtons, MediaPlayerMetaData],
        right_modules: [Network, VolumeOutput, Clock, Tray],
    ),


